#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
Usage: $(basename "$0")

Cleans up the current branch after its pull request has been merged.

Switches to the default branch, pulls the latest changes, and deletes
the current branch. Refuses to run if there are uncommitted changes,
if the pull request cannot be found, or if the pull request is still open.

Requires: gh (GitHub CLI)
EOF
  exit 0
fi

# Refuse to run if there are uncommitted or staged changes
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "error: there are uncommitted changes in the working directory" >&2
  echo "Commit or stash your changes before running this script." >&2
  exit 1
fi

# Get the current branch name
CURRENT_BRANCH=$(git branch --show-current)

if [[ -z "$CURRENT_BRANCH" ]]; then
  echo "error: not on a branch (detached HEAD)" >&2
  exit 1
fi

# Determine the default branch by querying the remote directly
DEFAULT_BRANCH=$(git ls-remote --symref origin HEAD 2>/dev/null | awk '/^ref:/ { sub(/refs\/heads\//, "", $2); print $2; exit }')

if [[ -z "$DEFAULT_BRANCH" ]]; then
  echo "error: cannot determine default branch from remote 'origin'" >&2
  exit 1
fi

if [[ "$CURRENT_BRANCH" == "$DEFAULT_BRANCH" ]]; then
  echo "error: already on the default branch '$DEFAULT_BRANCH'" >&2
  exit 1
fi

# Check that the pull request for the current branch is not open
if ! command -v gh &>/dev/null; then
  echo "error: 'gh' is required to check pull request state but was not found" >&2
  exit 1
fi

PR_STATE=$(gh pr view "$CURRENT_BRANCH" --json state --jq '.state' 2>/dev/null) || true

if [[ -z "${PR_STATE:-}" ]]; then
  echo "error: no pull request found for branch '$CURRENT_BRANCH'" >&2
  exit 1
elif [[ "$PR_STATE" == "OPEN" ]]; then
  echo "error: the pull request for '$CURRENT_BRANCH' is still open" >&2
  exit 1
fi

# Switch to the default branch, pull, and delete the feature branch
git -c checkout.defaultRemote=origin checkout "$DEFAULT_BRANCH"
git pull
git branch -d "$CURRENT_BRANCH"

echo "SUCCESS"
